# --- data: never committed, always regenerable from the manifest ---
data/raw/
data/interim/
data/processed/
!data/manifest/

# results. per-trial output is big and regenerable
results/trials/
results/landscape/
results/*.parquet
results/*.csv

# figures, rebuilt from the notebooks
figures/*.pdf
figures/*.png
figures/*.prov.json

# --- env ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- notebooks: outputs stripped by nbstripout; keep the paired .py as the diffable source ---
